{
  "globs": ["**/*.md"],
  "ignores": ["**/CHANGELOG.md", "**/node_modules/**/*"],
  "config": {
    "default": true,
    "MD007": { "indent": 2 },
    "MD013": false,
    "MD024": { "allow_different_nesting": true },
    "MD025": false,
    "MD026": { "punctuation": ".,;:!。，；:" },
    "MD029": false,
    "MD033": false,
    "MD040": false
  }
}
